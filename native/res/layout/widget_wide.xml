<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_bg">
  <ImageView android:id="@+id/ring" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingLeft="8dp">
    <TextView android:id="@+id/left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F3F3EF" android:textSize="14sp" android:layout_marginBottom="8dp"/>
    <Button android:id="@+id/b250" android:layout_width="match_parent" android:layout_height="38dp" android:text="+250 ml" android:textColor="#F3F3EF" android:textSize="13sp" android:background="@drawable/btn_bg" android:layout_marginBottom="6dp"/>
    <Button android:id="@+id/b500" android:layout_width="match_parent" android:layout_height="38dp" android:text="+500 ml" android:textColor="#F3F3EF" android:textSize="13sp" android:background="@drawable/btn_bg"/>
  </LinearLayout>
</LinearLayout>
